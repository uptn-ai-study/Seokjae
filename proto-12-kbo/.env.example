# NVIDIA NIM(build.nvidia.com) API 키 — 뉴스 감성 분석을 Qwen 3.5 로 수행할 때 사용.
# 이 파일을 복사해 .env 로 만들고 실제 키를 넣으세요(.env 는 git 에 커밋되지 않습니다).
#   cp .env.example .env
# 키가 없으면 자동으로 무료 사전(키워드) 방식으로 폴백합니다.
NVIDIA_API_KEY=

# (선택) 감성 분석 모델 override. 기본값: google/gemma-4-31b-it
# 무료 엔드포인트 실측상 Gemma 4 31B 가 한국어·속도·안정성 최적입니다.
# NVIDIA_MODEL=google/gemma-4-31b-it
